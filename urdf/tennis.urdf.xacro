<?xml version="1.0"?>
<robot name="teambot" xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_waffle_pi.urdf"/>
<!-- Low-friction passive supports; driven tyres retain traction. -->
<gazebo reference="caster_back_left_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
<gazebo reference="caster_back_right_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
<gazebo reference="wheel_left_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
<gazebo reference="wheel_right_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
<gazebo reference="base_scan"><sensor name="lidar" type="gpu_lidar">
<topic>/scan</topic><gz_frame_id>base_scan</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
<lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.12</min><max>20</max><resolution>0.01</resolution></range></lidar>
</sensor></gazebo>
<gazebo reference="camera_rgb_frame"><sensor name="camera" type="camera">
<topic>/camera/image_raw</topic><gz_frame_id>camera_rgb_optical_frame</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on>
<camera><camera_info_topic>/camera/camera_info</camera_info_topic><horizontal_fov>1.085595</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.03</near><far>50</far></clip></camera>
</sensor></gazebo>
<gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
<left_joint>wheel_left_joint</left_joint><right_joint>wheel_right_joint</right_joint><wheel_separation>0.288</wheel_separation><wheel_radius>0.033</wheel_radius>
<topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publisher_frequency>30</odom_publisher_frequency><max_linear_acceleration>0.5</max_linear_acceleration><max_angular_acceleration>1.5</max_angular_acceleration>
</plugin><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic><joint_name>wheel_left_joint</joint_name><joint_name>wheel_right_joint</joint_name></plugin></gazebo>
</robot>
